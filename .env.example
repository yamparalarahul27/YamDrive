# Copy to .env and fill in. .env is git-ignored.
#
# Native Android Maps SDK key. Baked into AndroidManifest.xml by prebuild.
# Restrict to Android apps: package name + signing cert SHA-1.
# Required for a development/production build; not used by Expo Go.
GOOGLE_MAPS_API_KEY=

# Places API (New) key, inlined into the JS bundle and sent on REST calls.
# Restrict by API (Places API only). Treat as public.
# Optional — without it, search falls back to the OS geocoder and the
# nearby-category buttons explain what to enable.
EXPO_PUBLIC_GOOGLE_PLACES_API_KEY=
